# Example environment file for ml-data-pipeline.
# Copy to .env in the repo root and adjust values for your environment.

# Remote Supabase/Postgres access
SUPABASE_USER=REPLACE_ME_WITH_YOUR_SUPABASE_USERNAME
SUPABASE_PASS=REPLACE_ME_WITH_YOUR_SUPABASE_PASSWORD
SUPABASE_STAGING_ID=REPLACE_ME_WITH_YOUR_SUPABASE_STAGING_ID
SUPABASE_PROD_ID=REPLACE_ME_WITH_YOUR_SUPABASE_PROD_ID

SUPABASE_STAGING_URI="postgresql://${SUPABASE_USER}.${SUPABASE_STAGING_ID}:${SUPABASE_PASS}@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
SUPABASE_PROD_URI="postgresql://${SUPABASE_USER}.${SUPABASE_PROD_ID}:${SUPABASE_PASS}@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Remote Supabase REST writes for staging/prod runs
SUPABASE_URL=REPLACE_ME_WITH_YOUR_SUPABASE_REST_URL
SUPABASE_KEY=REPLACE_ME_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY

# Local sandbox access
# These match the sandbox startup flow in:
# cell_observatory_platform/scripts/db/local_start_sandbox.sh
SUPABASE_LOCAL_PORT=5433
SUPABASE_LOCAL_HOST=
SUPABASE_LOCAL_URI=

# Sandbox startup variables used by the platform repo script
DATABASE_SANDBOX=REPLACE_ME_WITH_PATH_TO_SANDBOX_TARBALL
REPO_DIR=REPLACE_ME_WITH_YOUR_REPO_DIR
DATA_DIR=REPLACE_ME_WITH_YOUR_DATA_DIR
STORAGE_SERVER_DIR=REPLACE_ME_WITH_YOUR_STORAGE_SERVER_DIR
DATABASE_DIR=REPLACE_ME_WITH_YOUR_DATABASE_DIR
NODE_LOCAL_STORE_ROOT=/scratch/$USER/node_local_store
SCRATCH_ROOT=/scratch/$USER
SANDBOX_DIR=/scratch/$USER/sandbox
SANDBOX_INSTANCE_NAME=sandbox_pg
SANDBOX_WAIT_SECONDS=60
